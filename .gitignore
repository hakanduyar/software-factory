# No trailing slash, deliberately: `node_modules/` matches a DIRECTORY and
# not a SYMLINK of the same name, so a git worktree that links to the main
# checkout's dependencies had its link staged by `git add -A` and committed.
node_modules
dist/
*.tsbuildinfo
.env
.env.*

# Local SQLite persistence (TASK-002) — runtime data, never committed.
.factory-data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# Crash journal for scripts/mutate.mjs. Present only while mutations are
# applied; its presence on startup means the previous run was killed, and the
# harness puts the recorded bytes back and refuses.
.mutation-journal.json
